<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>
    <groupId>com.hivefive</groupId>
    <artifactId>hivefive-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>hivefive-backend</name>
    <description>Parent Maven multi-module para el backend HiveFive</description>

    <modules>
        <module>hivefive-common</module>
        <module>hivefive-role</module>
        <module>hivefive-status</module>
        <module>hivefive-user</module>
        <module>hivefive-board</module>
        <module>hivefive-card</module>
        <module>hivefive-checklist</module>
        <module>hivefive-userboard</module>
        <module>hivefive-api-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-role</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-status</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-board</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-card</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-checklist</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.hivefive</groupId>
                <artifactId>hivefive-userboard</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
