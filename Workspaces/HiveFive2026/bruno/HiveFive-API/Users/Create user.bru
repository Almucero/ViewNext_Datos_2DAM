meta {
  name: Create user
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/users/create
  body: json
  auth: none
}

body:json {
  {
    "User": [
      {
        "id": {{newUserId}},
        "roleId": 3,
        "email": "nuevo.usuario@example.com",
        "firstName": "Nombre",
        "lastName": "Apellido",
        "password": "contraseñaSegura123"
      }
    ]
  }
}

headers {
  Content-Type: application/json
  Accept: application/json
}
