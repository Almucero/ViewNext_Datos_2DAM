<process name="getAllChecklistItem"
               targetNamespace="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_CHECKLIST_ITEM/getAllChecklistItem"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_CHECKLIST_ITEM/getAllChecklistItem"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:ui="http://xmlns.oracle.com/soa/designer"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http://xmlns.oracle.com/pcbpel/adapter/db/CRUD_HIVEFIVE/CRUD_CHECKLIST_ITEM/dbChecklistItem">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_CHECKLIST_ITEM/getAllChecklistItem" location="../WSDLs/getAllChecklistItem.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
  <partnerLinks>
    <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
    <partnerLink name="getallchecklistitem_client" partnerLinkType="client:getAllChecklistItem" myRole="getAllChecklistItemProvider"/>
    <partnerLink name="dbChecklistItem" partnerLinkType="ns1:dbChecklistItem_plt" partnerRole="dbChecklistItem_role"/>
  </partnerLinks>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      VARIABLES                                                        
      List of messages and XML documents used within this BPEL process 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <variables>
    <!-- Reference to the message passed as input during initiation -->
    <variable name="inputVariable" messageType="client:getAllChecklistItemRequestMessage"/>

    <!-- Reference to the message that will be returned to the requester-->
    <variable name="outputVariable" messageType="client:getAllChecklistItemResponseMessage"/>
    <variable name="Invoke1_dbChecklistItemSelect_InputVariable"
              messageType="ns1:dbChecklistItemSelect_inputParameters"/>
    <variable name="Invoke1_dbChecklistItemSelect_OutputVariable" messageType="ns1:ChecklistItemCollection_msg"/>
  </variables>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC                                               
     Set of activities coordinating the flow of messages across the    
     services integrated within this business process                  
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <sequence name="main">

    <!-- Receive input from requestor. (Note: This maps to operation defined in getAllChecklistItem.wsdl) -->
    <receive name="receiveInput" partnerLink="getallchecklistitem_client" portType="client:getAllChecklistItem" operation="process" variable="inputVariable" createInstance="yes"/>
    <assign name="Assign1">
      <copy>
        <from>$inputVariable.payload</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$Invoke1_dbChecklistItemSelect_InputVariable.dbChecklistItemSelect_inputParameters</to>
      </copy>
    </assign>
    <invoke name="Invoke1" partnerLink="dbChecklistItem" portType="ns1:dbChecklistItem_ptt"
            operation="dbChecklistItemSelect" inputVariable="Invoke1_dbChecklistItemSelect_InputVariable"
            outputVariable="Invoke1_dbChecklistItemSelect_OutputVariable" bpelx:invokeAsDetail="no"/>
    <assign name="Transformation1">
      <bpelx:annotation>
        <bpelx:pattern patternName="bpelx:transformation"></bpelx:pattern>
      </bpelx:annotation>
      <copy>
        <from>ora:doXSLTransformForDoc("../Transformations/Transformation1_1.xsl", $Invoke1_dbChecklistItemSelect_OutputVariable.ChecklistItemCollection)</from>
        <to variable="outputVariable" part="payload"/>
      </copy>
    </assign>
    <!-- Generate reply to synchronous request -->
    <reply name="replyOutput" partnerLink="getallchecklistitem_client" portType="client:getAllChecklistItem" operation="process" variable="outputVariable"/>
  </sequence>
</process>