<?xml version="1.0" encoding="UTF-8" ?>
<compositeTest compositeDN="CRUD_CARD" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Valida que delete solo devuelve id aunque lleguen mas campos</about>
  <initiate serviceName="deletecard_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <cli:deleteCard xmlns:cli="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_CARD/deleteCard">
            <ns2:Card xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard">
              <ns2:id>1001</ns2:id>
              <ns2:title>Este titulo no debe salir en respuesta</ns2:title>
              <ns2:description>Este campo debe ser ignorado en el output</ns2:description>
            </ns2:Card>
          </cli:deleteCard>
        </content>
      </part>
    </message>
  </initiate>
  <wireActions wireSource="deletecard_client_ep" operation="process">
    <assert comparisonMethod="xml-similar">
      <expected>
        <location key="output"/>
        <message>
          <part partName="payload">
            <content>
              <ns2:CardCollection xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard">
                <ns2:Card>
                  <ns2:id>1001</ns2:id>
                </ns2:Card>
              </ns2:CardCollection>
            </content>
          </part>
        </message>
      </expected>
    </assert>
  </wireActions>
</compositeTest>
