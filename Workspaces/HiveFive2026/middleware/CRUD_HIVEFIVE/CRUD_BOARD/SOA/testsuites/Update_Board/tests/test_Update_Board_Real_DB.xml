<?xml version="1.0" encoding="UTF-8" ?>
<compositeTest compositeDN="CRUD_BOARD" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Test Real BD de updateBoard sin emulacion</about>

  <initiate serviceName="updateboard_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <Board xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard">
            <id>999999</id>
            <name>Board Update Real DB</name>
          </Board>
        </content>
      </part>
    </message>
  </initiate>

  <wireActions wireSource="updateBoard/dbBoard" operation="update"/>

  <wireActions wireSource="updateboard_client_ep" operation="process">
    <assert comparisonMethod="xml-similar">
      <description>Verifica ejecucion real sin mock y salida del BPEL</description>
      <expected>
        <location key="output"/>
        <message>
          <part partName="payload">
            <content>
              <Board xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard">
                <id>999999</id>
                <name>Board Update Real DB</name>
              </Board>
            </content>
          </part>
        </message>
      </expected>
    </assert>
  </wireActions>
</compositeTest>