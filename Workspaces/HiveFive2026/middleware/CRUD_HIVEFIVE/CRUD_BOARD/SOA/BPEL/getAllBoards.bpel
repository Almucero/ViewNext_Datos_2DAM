<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer 
  
  Created: Thu Mar 26 08:16:43 CET 2026
  Author:  6003545
  Type: BPEL 2.0 Process
  Purpose: Synchronous BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="getAllBoards"
               targetNamespace="http://xmlns.oracle.com/HiveFiveCrud/CRUD_BOARD/getAllBoards"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/HiveFiveCrud/CRUD_BOARD/getAllBoards"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:ui="http://xmlns.oracle.com/soa/designer"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http://xmlns.oracle.com/pcbpel/adapter/db/CRUDHiveFive/CRUD_BOARD/dbBoard">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/HiveFiveCrud/CRUD_BOARD/getAllBoards" location="../WSDLs/getAllBoards.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
  <partnerLinks>
    <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
    <partnerLink name="getallboards_client" partnerLinkType="client:getAllBoards" myRole="getAllBoardsProvider"/>
    <partnerLink name="dbBoard" partnerLinkType="ns1:dbBoard_plt" partnerRole="dbBoard_role"/>
  </partnerLinks>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      VARIABLES                                                        
      List of messages and XML documents used within this BPEL process 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <variables>
    <!-- Reference to the message passed as input during initiation -->
    <variable name="inputVariable" messageType="client:getAllBoardsRequestMessage"/>

    <!-- Reference to the message that will be returned to the requester-->
    <variable name="outputVariable" messageType="client:getAllBoardsResponseMessage"/>
    <variable name="Invoke1_dbBoardSelect_InputVariable" messageType="ns1:dbBoardSelect_inputParameters"/>
    <variable name="Invoke1_dbBoardSelect_OutputVariable" messageType="ns1:BoardCollection_msg"/>
  </variables>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC                                               
     Set of activities coordinating the flow of messages across the    
     services integrated within this business process                  
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <sequence name="main">

    <!-- Receive input from requestor. (Note: This maps to operation defined in getAllBoards.wsdl) -->
    <receive name="receiveInput" partnerLink="getallboards_client" portType="client:getAllBoards" operation="process" variable="inputVariable" createInstance="yes"/>
    <assign name="Assign1">
      <copy>
        <from>$inputVariable.payload</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$Invoke1_dbBoardSelect_InputVariable.dbBoardSelect_inputParameters</to>
      </copy>
    </assign>
    <invoke name="Invoke1" partnerLink="dbBoard" portType="ns1:dbBoard_ptt"
            operation="dbBoardSelect" inputVariable="Invoke1_dbBoardSelect_InputVariable"
            outputVariable="Invoke1_dbBoardSelect_OutputVariable" bpelx:invokeAsDetail="no"/>
    <assign name="Transformation">
      <bpelx:annotation>
        <bpelx:pattern patternName="bpelx:transformation"></bpelx:pattern>
      </bpelx:annotation>
      <copy>
        <from>ora:doXSLTransformForDoc("../Transformations/Transformation1_3.xsl", $Invoke1_dbBoardSelect_OutputVariable.BoardCollection)</from>
        <to variable="outputVariable" part="payload"/>
      </copy>
    </assign>
    <!-- Generate reply to synchronous request -->
    <reply name="replyOutput" partnerLink="getallboards_client" portType="client:getAllBoards" operation="process" variable="outputVariable"/>
  </sequence>
</process>