<?xml version="1.0" encoding="UTF-8" ?>
<!-- Nueva variante de prueba: actualizar el nombre del status con ID 60 -->
<compositeTest compositeDN="CRUD_STATUS" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Actualizar el nombre del status ID 60 a unitariaActualizada</about>
  <initiate serviceName="updatestatus_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <StatusCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus">
            <Status>
              <id>60</id>
              <name>unitariaActualizada</name>
            </Status>
          </StatusCollection>
        </content>
      </part>
    </message>
  </initiate>
  <wireActions wireSource="updatestatus_client_ep" operation="process">
    <assert comparisonMethod="xml-similar">
      <description/>
      <expected>
        <location key="output"/>
        <message>
          <part partName="payload">
            <content>
              <StatusCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus">
                <Status>
                  <id>60</id>
                  <name>unitariaActualizada</name>
                </Status>
              </StatusCollection>
            </content>
          </part>
        </message>
      </expected>
    </assert>
  </wireActions>
</compositeTest>
