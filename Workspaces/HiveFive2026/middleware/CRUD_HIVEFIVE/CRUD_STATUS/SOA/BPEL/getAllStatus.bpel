<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer 
  
  Created: Fri Mar 20 11:44:57 GMT 2026
  Author:  oracle
  Type: BPEL 2.0 Process
  Purpose: Synchronous BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="getAllStatus"
               targetNamespace="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_STATUS/getAllStatus"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_STATUS/getAllStatus"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:ui="http://xmlns.oracle.com/soa/designer"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http://xmlns.oracle.com/pcbpel/adapter/db/CRUD_HIVEFIVE/CRUD_STATUS/dbStatus">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_STATUS/getAllStatus" location="../WSDLs/getAllStatus.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
  <partnerLinks>
    <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
    <partnerLink name="getallstatus_client" partnerLinkType="client:getAllStatus" myRole="getAllStatusProvider"/>
    <partnerLink name="dbStatus" partnerLinkType="ns1:dbStatus_plt" partnerRole="dbStatus_role"/>
  </partnerLinks>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      VARIABLES                                                        
      List of messages and XML documents used within this BPEL process 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <variables>
    <!-- Reference to the message passed as input during initiation -->
    <variable name="inputVariable" messageType="client:getAllStatusRequestMessage"/>

    <!-- Reference to the message that will be returned to the requester-->
    <variable name="outputVariable" messageType="client:getAllStatusResponseMessage"/>
    <variable name="Invoke1_dbStatusSelect_InputVariable" messageType="ns1:dbStatusSelect_inputParameters"/>
    <variable name="Invoke1_dbStatusSelect_OutputVariable" messageType="ns1:StatusCollection_msg"/>
  </variables>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC                                               
     Set of activities coordinating the flow of messages across the    
     services integrated within this business process                  
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <sequence name="main">

    <!-- Receive input from requestor. (Note: This maps to operation defined in getAllStatus.wsdl) -->
    <receive name="receiveInput" partnerLink="getallstatus_client" portType="client:getAllStatus" operation="process" variable="inputVariable" createInstance="yes"/>
    <assign name="Assign1">
      <copy>
        <from>$inputVariable.payload</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$Invoke1_dbStatusSelect_InputVariable.dbStatusSelect_inputParameters</to>
      </copy>
    </assign>
    <invoke name="Invoke1" partnerLink="dbStatus" portType="ns1:dbStatus_ptt"
            operation="dbStatusSelect" inputVariable="Invoke1_dbStatusSelect_InputVariable"
            outputVariable="Invoke1_dbStatusSelect_OutputVariable" bpelx:invokeAsDetail="no"/>
    <assign name="Transformation1">
      <bpelx:annotation>
        <bpelx:pattern patternName="bpelx:transformation"></bpelx:pattern>
      </bpelx:annotation>
      <copy>
        <from>ora:doXSLTransformForDoc("../Transformations/Transformation1_1.xsl", $Invoke1_dbStatusSelect_OutputVariable.StatusCollection)</from>
        <to variable="outputVariable" part="payload"/>
      </copy>
    </assign>
    <!-- Generate reply to synchronous request -->
    <reply name="replyOutput" partnerLink="getallstatus_client" portType="client:getAllStatus" operation="process" variable="outputVariable"/>
  </sequence>
</process>