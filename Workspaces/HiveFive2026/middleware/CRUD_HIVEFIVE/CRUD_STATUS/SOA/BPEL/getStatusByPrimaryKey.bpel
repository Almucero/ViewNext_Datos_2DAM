<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer 
  
  Created: Fri Mar 20 11:44:37 GMT 2026
  Author:  oracle
  Type: BPEL 2.0 Process
  Purpose: Synchronous BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="getStatusByPrimaryKey"
               targetNamespace="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_STATUS/getStatusByPrimaryKey"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_STATUS/getStatusByPrimaryKey"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:ui="http://xmlns.oracle.com/soa/designer"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http://xmlns.oracle.com/pcbpel/adapter/db/CRUD_HIVEFIVE/CRUD_STATUS/dbStatus"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_STATUS/getStatusByPrimaryKey" location="../WSDLs/getStatusByPrimaryKey.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
  <partnerLinks>
    <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
    <partnerLink name="getstatusbyprimarykey_client" partnerLinkType="client:getStatusByPrimaryKey" myRole="getStatusByPrimaryKeyProvider"/>
    <partnerLink name="dbStatus" partnerLinkType="ns1:dbStatus_plt" partnerRole="dbStatus_role"/>
  </partnerLinks>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      VARIABLES                                                        
      List of messages and XML documents used within this BPEL process 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <variables>
    <!-- Reference to the message passed as input during initiation -->
    <variable name="inputVariable" messageType="client:getStatusByPrimaryKeyRequestMessage"/>

    <!-- Reference to the message that will be returned to the requester-->
    <variable name="outputVariable" messageType="client:getStatusByPrimaryKeyResponseMessage"/>
    <variable name="Invoke1_selectByPrimaryKey_InputVariable" messageType="ns1:selectByPrimaryKey_inputParameters"/>
    <variable name="Invoke1_selectByPrimaryKey_OutputVariable" messageType="ns1:StatusCollection_msg"/>
  </variables>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC                                               
     Set of activities coordinating the flow of messages across the    
     services integrated within this business process                  
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <sequence name="main">

    <!-- Receive input from requestor. (Note: This maps to operation defined in getStatusByPrimaryKey.wsdl) -->
    <receive name="receiveInput" partnerLink="getstatusbyprimarykey_client" portType="client:getStatusByPrimaryKey" operation="process" variable="inputVariable" createInstance="yes"/>
    <assign name="Assign1">
      <copy>
        <from>$inputVariable.payload/ns2:Status/ns2:id</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$Invoke1_selectByPrimaryKey_InputVariable.selectByPrimaryKey_inputParameters/ns2:id</to>
      </copy>
    </assign>
    <invoke name="Invoke1" partnerLink="dbStatus" portType="ns1:dbStatus_ptt"
            operation="selectByPrimaryKey" inputVariable="Invoke1_selectByPrimaryKey_InputVariable"
            outputVariable="Invoke1_selectByPrimaryKey_OutputVariable" bpelx:invokeAsDetail="no"/>
    <assign name="Assign2">
      <copy>
        <from>$Invoke1_selectByPrimaryKey_OutputVariable.StatusCollection/ns2:Status</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$outputVariable.payload/ns2:Status</to>
      </copy>
    </assign>
    <!-- Generate reply to synchronous request -->
    <reply name="replyOutput" partnerLink="getstatusbyprimarykey_client" portType="client:getStatusByPrimaryKey" operation="process" variable="outputVariable"/>
  </sequence>
</process>