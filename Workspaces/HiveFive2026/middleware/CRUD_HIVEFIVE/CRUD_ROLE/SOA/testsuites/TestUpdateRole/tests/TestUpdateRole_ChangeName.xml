<?xml version="1.0" encoding="UTF-8" ?>
<!-- Nueva variante de prueba: actualizar el nombre del role ID 13 -->
<compositeTest compositeDN="CRUD_ROLE" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Actualizar el nombre del role ID 13 a pruebaUnitariaActualizada</about>
  <initiate serviceName="updaterole_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <RoleCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbReference">
            <Role>
              <id>13</id>
              <name>pruebaUnitariaActualizada</name>
            </Role>
          </RoleCollection>
        </content>
      </part>
    </message>
  </initiate>
  <wireActions wireSource="updaterole_client_ep" operation="process">
    <assert comparisonMethod="xml-similar">
      <description/>
      <expected>
        <location key="output"/>
        <message>
          <part partName="payload">
            <content>
              <RoleCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbReference">
                <Role>
                  <id>13</id>
                  <name>pruebaUnitariaActualizada</name>
                </Role>
              </RoleCollection>
            </content>
          </part>
        </message>
      </expected>
    </assert>
  </wireActions>
</compositeTest>
