                            </con1:actions>
                        </con1:case>
                        <con1:case id="_BranchId-N53eefffe.N5094dfb5.0.19d1a0e6c75.N7c29">
                            <con1:condition>
                                <con2:xqueryText>$fault/ctx:details/*[local-name()='ReceivedFaultDetail']/*[local-name()='http-response-code'] = '401'</con2:xqueryText>
