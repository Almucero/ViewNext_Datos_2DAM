            <con:stage id="_StageId-N53eefffe.N5094dfb5.0.19d1a0e6c75.N7e6d" name="Stage1">
                <con:context/>
                <con:actions>
                    <con1:ifThenElse>
                        <con2:id>_ActionId-N53eefffe.N5094dfb5.0.19d1a0e6c75.N7c2c</con2:id>
                        <con1:case id="_BranchId-N53eefffe.N5094dfb5.0.19d1a0e6c75.N7c2b">
                            <con1:condition>
                                <con2:xqueryText>$fault/ctx:details/*[local-name()='ReceivedFaultDetail']/*[local-name()='http-response-code'] = '400'</con2:xqueryText>
                            </con1:condition>
                            <con1:actions>
