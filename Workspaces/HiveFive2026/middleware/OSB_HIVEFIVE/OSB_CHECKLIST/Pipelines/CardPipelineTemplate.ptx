                                    <con2:id>_ActionId-N53eefffe.N5094dfb5.0.19d1a0e6c75.N7bf1</con2:id>
                                    <con1:location>
                                        <con2:xpathText>.</con2:xpathText>
                                    </con1:location>
                                    <con1:expr>
                                        <con2:xqueryText>'{ "codigo": "400", "mensaje": "Petición incorrecta. Faltan datos o el formato no es válido." }'</con2:xqueryText>
                                    </con1:expr>
                                </con1:replace>
                                <con1:transport-headers>
                                    <con2:id>_ActionId-N53eefffe.N5094dfb5.0.19d1a0e6c75.N7be8</con2:id>
                                    <con1:header-set>inbound-response</con1:header-set>
                                    <con1:header value="expression" name="http-response-code">
                                        <con2:xqueryText>'400'</con2:xqueryText>
                                    </con1:header>
                                </con1:transport-headers>
                                <con2:reply isError="false">
                                    <con2:id>_ActionId-N53eefffe.N5094dfb5.0.19d1a0e6c75.N7be5</con2:id>
