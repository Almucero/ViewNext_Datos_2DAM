<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns0="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="UpdateBoard_Experience">RestService</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard" schemaLocation="../Schemas/UpdateBoardSchema.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/update/board">
         <method name="POST" soa:wsdlOperation="BoardUpdate">
            <request>
               <representation mediaType="application/json" element="cns:BoardCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:BoardCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard"/>
            </response>
         </method>
      </resource>
   </resources>
</application>
