<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns0="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CreateBoard_Experience">RestService create boards</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard" schemaLocation="../Schemas/CreateBoards_Payload.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/boards/create">
         <method name="POST" soa:wsdlOperation="createBoard">
            <request>
               <representation mediaType="application/json" element="cns:BoardCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:BoardCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard"/>
            </response>
         </method>
      </resource>
   </resources>
</application>