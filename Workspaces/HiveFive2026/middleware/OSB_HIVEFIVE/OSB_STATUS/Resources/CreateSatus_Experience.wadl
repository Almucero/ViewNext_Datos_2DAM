<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns0="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CreateSatus_Experience">RestService</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus" schemaLocation="../Shemas/createstatusSchema.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/create/status">
         <method name="POST" soa:wsdlOperation="createStatus">
            <request>
               <representation mediaType="application/json" element="cns:StatusCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:StatusCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus"/>
            </response>
         </method>
      </resource>
   </resources>
</application>