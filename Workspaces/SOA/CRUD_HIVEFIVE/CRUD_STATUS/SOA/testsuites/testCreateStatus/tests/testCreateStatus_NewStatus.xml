<?xml version="1.0" encoding="UTF-8" ?>
<!-- Nueva variante de prueba: creación válida de un status con ID no existente -->
<compositeTest compositeDN="CRUD_STATUS" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Crear un nuevo status unitario con ID 100</about>
  <initiate serviceName="createstatus_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <StatusCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus">
            <Status>
              <id>100</id>
              <name>unitariaCreada</name>
            </Status>
          </StatusCollection>
        </content>
      </part>
    </message>
  </initiate>
  <wireActions wireSource="createstatus_client_ep" operation="process">
    <assert comparisonMethod="xml-similar">
      <description/>
      <expected>
        <location key="output"/>
        <message>
          <part partName="payload">
            <content>
              <StatusCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus">
                <Status>
                  <id>100</id>
                  <name>unitariaCreada</name>
                </Status>
              </StatusCollection>
            </content>
          </part>
        </message>
      </expected>
    </assert>
  </wireActions>
</compositeTest>
