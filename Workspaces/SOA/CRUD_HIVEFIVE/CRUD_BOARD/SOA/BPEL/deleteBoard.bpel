<?xml version = "1.0" encoding = "UTF-8" ?>
<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer 
  
  Created: Thu Mar 19 13:00:48 CET 2026
  Author:  6003545
  Type: BPEL 2.0 Process
  Purpose: Synchronous BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="deleteBoard"
               targetNamespace="http://xmlns.oracle.com/CRUDHiveFive/CRUD_BOARD/deleteBoard"
               xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
               xmlns:client="http://xmlns.oracle.com/CRUDHiveFive/CRUD_BOARD/deleteBoard"
               xmlns:ora="http://schemas.oracle.com/xpath/extension"
               xmlns:ui="http://xmlns.oracle.com/soa/designer"
               xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http://xmlns.oracle.com/pcbpel/adapter/db/CRUDHiveFive/CRUD_BOARD/dbBoard"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/CRUDHiveFive/CRUD_BOARD/deleteBoard" location="../WSDLs/deleteBoard.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
  <partnerLinks>
    <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
    <partnerLink name="deleteboard_client" partnerLinkType="client:deleteBoard" myRole="deleteBoardProvider"/>
    <partnerLink name="dbBoard" partnerLinkType="ns1:dbBoard_plt" partnerRole="dbBoard_role"/>
  </partnerLinks>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
      VARIABLES                                                        
      List of messages and XML documents used within this BPEL process 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <variables>
    <!-- Reference to the message passed as input during initiation -->
    <variable name="inputVariable" messageType="client:deleteBoardRequestMessage"/>

    <!-- Reference to the message that will be returned to the requester-->
    <variable name="outputVariable" messageType="client:deleteBoardResponseMessage"/>
    <variable name="Invoke1_delete_InputVariable" messageType="ns1:BoardCollection_msg"/>
    <variable name="Invoke1_delete_OutputVariable" messageType="ns1:BoardCollection_msg"/>
  </variables>

  <!-- 
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
     ORCHESTRATION LOGIC                                               
     Set of activities coordinating the flow of messages across the    
     services integrated within this business process                  
    ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  -->
  <sequence name="main">

    <!-- Receive input from requestor. (Note: This maps to operation defined in deleteBoard.wsdl) -->
    <receive name="receiveInput" partnerLink="deleteboard_client" portType="client:deleteBoard" operation="process" variable="inputVariable" createInstance="yes"/>
    <assign name="Assign1">
      <copy>
        <!-- [1] asegura selección única para evitar selectionFailure -->
        <from>$inputVariable.payload/ns2:id[1]</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$Invoke1_delete_InputVariable.BoardCollection/ns2:Board/ns2:id</to>
      </copy>
    </assign>
    <invoke name="Invoke1" partnerLink="dbBoard" portType="ns1:dbBoard_ptt"
            operation="delete" inputVariable="Invoke1_delete_InputVariable"
            outputVariable="Invoke1_delete_OutputVariable" bpelx:invokeAsDetail="no"/>
    <assign name="Assign2">
      <copy>
        <!--
          Si el adapter devuelve BoardCollection vacío, seleccionamos el primer Board devuelto; si no existe,
          usamos el payload de entrada para no fallar con selectionFailure.
        -->
        <from>($Invoke1_delete_OutputVariable.BoardCollection/ns2:Board[1] | $inputVariable.payload)[1]</from>
        <to expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath1.0">$outputVariable.payload</to>
      </copy>
    </assign>
    <!-- Generate reply to synchronous request -->
    <reply name="replyOutput" partnerLink="deleteboard_client" portType="client:deleteBoard" operation="process" variable="outputVariable"/>
  </sequence>
</process>