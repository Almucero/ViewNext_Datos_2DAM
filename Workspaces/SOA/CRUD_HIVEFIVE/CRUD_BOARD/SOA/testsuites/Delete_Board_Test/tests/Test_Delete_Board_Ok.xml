<?xml version="1.0" encoding="UTF-8" ?>
<compositeTest compositeDN="CRUD_BOARD" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Test Real a BD de Delete Board estandarizado</about>
  
  <initiate serviceName="deleteboard_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <Board xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbBoard">
            <!-- El ID del tablero a borrar -->
            <id>5594</id>
          </Board>
        </content>
      </part>
    </message>
  </initiate>

  <wireActions wireSource="deleteboard_client_ep" operation="process">
    <assert comparisonMethod="string">
      <description>Verifica que se devuelve el ID borrado</description>
      <expected>
        <!-- Misma estructura limpia que en User: busca un nodo 'id' sin importar su namespace -->
        <location key="output" partName="payload" xpath="//*[local-name()='id']"/>
        <simple>5594</simple>
      </expected>
    </assert>
  </wireActions>
</compositeTest>
