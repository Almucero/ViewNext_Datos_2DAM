<?xml version="1.0" encoding="UTF-8" ?>
<compositeTest compositeDN="CRUD_CARD" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Valida que getCardByPrimaryKey ignora campos extra y usa solo el id</about>
  <initiate serviceName="getcardbyprimarykey_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <cli:getCardByPrimaryKey xmlns:cli="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_CARD/getCardByPrimaryKey">
            <ns2:Card xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard">
              <ns2:id>1</ns2:id>
              <ns2:title>Este valor debe ser ignorado por el BPEL</ns2:title>
              <ns2:description>Campo extra en request</ns2:description>
            </ns2:Card>
          </cli:getCardByPrimaryKey>
        </content>
      </part>
    </message>
  </initiate>
  <wireActions wireSource="getcardbyprimarykey_client_ep" operation="process">
    <assert comparisonMethod="string">
      <expected>
        <location key="output" partName="payload" xpath="/ns2:CardCollection/ns2:Card/ns2:id" xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard"/>
        <simple>1</simple>
      </expected>
    </assert>
  </wireActions>
</compositeTest>
