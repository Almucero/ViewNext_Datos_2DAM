              <ns2:id>9999999</ns2:id>
            </ns2:Card>
          </cli:getCardByPrimaryKey>
        </content>
      </part>
    </message>
  </initiate>
  
  <wireActions wireSource="getcardbyprimarykey_client_ep" operation="process">
    <assert comparisonMethod="string">
      <expected>
        <location key="fault" partName="summary" xpath="/summary"/>
