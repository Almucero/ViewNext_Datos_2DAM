<?xml version="1.0" encoding="UTF-8" ?>
<compositeTest compositeDN="CRUD_CARD" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about></about>
  
  <initiate serviceName="getcardbyprimarykey_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <cli:getCardByPrimaryKey xmlns:cli="http://xmlns.oracle.com/CRUD_HIVEFIVE/CRUD_CARD/getCardByPrimaryKey">
            <ns2:Card xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard">
              <ns2:id>1</ns2:id>
            </ns2:Card>
          </cli:getCardByPrimaryKey>
        </content>
      </part>
    </message>
  </initiate>
  
  <wireActions wireSource="getcardbyprimarykey_client_ep" operation="process">
    <assert comparisonMethod="xml-similar">
      <description>Esperamos recibir los datos de la carta</description>
      <expected>
        <location key="output"/>
        
        <test:message xmlns:test="http://xmlns.oracle.com/sca/2006/test">
          <test:part partName="payload">
            <test:content>
              <dbc:CardCollection xmlns:dbc="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard">
                <dbc:Card>
                  <dbc:boardId>5</dbc:boardId>
                  <dbc:endDate>2014-11-07</dbc:endDate>
                  <dbc:id>1</dbc:id>
                  <dbc:priority>2</dbc:priority>
                  <dbc:startDate>2008-09-04</dbc:startDate>
                  <dbc:statusId>2</dbc:statusId>
                  <dbc:userId>1</dbc:userId>
                  <dbc:description>Descripción modificada</dbc:description>
                  <dbc:title>Tarjeta Actualizada</dbc:title>
                </dbc:Card>
              </dbc:CardCollection>
            </test:content>
          </test:part>
        </test:message>
        
      </expected>
    </assert>
  </wireActions>
  
</compositeTest>
