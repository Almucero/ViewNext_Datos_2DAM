<?xml version="1.0" encoding="UTF-8" ?>
<!-- Nueva variante de prueba: obtener el role con ID 4 (lola) -->
<compositeTest compositeDN="CRUD_ROLE" xmlns="http://xmlns.oracle.com/sca/2006/test">
  <about>Obtener role por clave primaria para ID 4</about>
  <initiate serviceName="getrolebyprimarykey_client_ep" operation="process" isAsync="false" delay="PT0S">
    <message>
      <part partName="payload">
        <content>
          <RoleCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbReference">
            <Role>
              <id>4</id>
            </Role>
          </RoleCollection>
        </content>
      </part>
    </message>
  </initiate>
  <wireActions wireSource="getrolebyprimarykey_client_ep" operation="process">
    <assert comparisonMethod="xml-similar">
      <description/>
      <expected>
        <location key="output"/>
        <message>
          <part partName="payload">
            <content>
              <RoleCollection xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbReference">
                <Role>
                  <id>4</id>
                  <name>lola</name>
                </Role>
              </RoleCollection>
            </content>
          </part>
        </message>
      </expected>
    </assert>
  </wireActions>
</compositeTest>
