<adapter-config name="WriteFixed" adapter="file" wsdlLocation="../WSDLs/WriteFixed.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  
  <connection-factory location="eis/FileAdapter"/>
  <endpoint-interaction portType="Write_ptt" operation="Write">
    <interaction-spec className="oracle.tip.adapter.file.outbound.FileInteractionSpec">
      <property name="PhysicalDirectory" value="/home/oracle/labs/output/native"/>
      <property name="Append" value="false"/>
      <property name="FileNamingConvention" value="po_%yyMMddHHmmss%.txt"/>
      <property name="NumberMessages" value="1"/>
    </interaction-spec>
  </endpoint-interaction>

</adapter-config>