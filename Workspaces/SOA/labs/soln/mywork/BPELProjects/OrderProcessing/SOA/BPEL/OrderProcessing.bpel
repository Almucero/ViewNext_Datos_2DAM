<?xml version = "1.0" encoding = "UTF-8" ?>
<!--
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
  Oracle JDeveloper BPEL Designer 
  
  Created: Tue Sep 30 09:09:28 UTC 2014
  Author:  oracle
  Type: BPEL 2.0 Process
  Purpose: Asynchronous BPEL Process
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
-->
<process name="OrderProcessing"
         targetNamespace="http://xmlns.oracle.com/BPELProjects/OrderProcessing/OrderProcessing"
         xmlns="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:client="http://xmlns.oracle.com/BPELProjects/OrderProcessing/OrderProcessing"
         xmlns:ora="http://schemas.oracle.com/xpath/extension"
         xmlns:ui="http://xmlns.oracle.com/soa/designer"
         xmlns:bpelx="http://schemas.oracle.com/bpel/extension"
         xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
         xmlns:ns1="http://xmlns.oracle.com/ApprovalRules/ApprovalRulesService"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns2="http://www.example.org/ns/orderproc"
         xmlns:ns4="http://www.example.org/ns/approvalrules" xmlns:ns3="http://xmlns.oracle.com/bpel"
         xmlns:xp20="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.Xpath20"
         xmlns:bpws="http://schemas.xmlsoap.org/ws/2003/03/business-process/"
         xmlns:oraext="http://www.oracle.com/XSL/Transform/java/oracle.tip.pc.services.functions.ExtFunc"
         xmlns:dvm="http://www.oracle.com/XSL/Transform/java/oracle.tip.dvm.LookupValue"
         xmlns:hwf="http://xmlns.oracle.com/bpel/workflow/xpath"
         xmlns:ids="http://xmlns.oracle.com/bpel/services/IdentityService/xpath"
         xmlns:bpm="http://xmlns.oracle.com/bpmn20/extensions" xmlns:ess="http://xmlns.oracle.com/scheduler"
         xmlns:xdk="http://schemas.oracle.com/bpel/extension/xpath/function/xdk"
         xmlns:xref="http://www.oracle.com/XSL/Transform/java/oracle.tip.xref.xpath.XRefXPathFunctions"
         xmlns:ldap="http://schemas.oracle.com/xpath/extension/ldap"
         xmlns:ns5="http://xmlns.oracle.com/BPELProjects/Approval/Approval"
         xmlns:ns6="http://www.example.org/ns/intorder"
         xmlns:ns7="http://xmlns.oracle.com/ShippingRules/ShippingRulesService"
         xmlns:ns8="http://www.example.org/ns/shippingrules">

    <import ui:processWSDL="true" namespace="http://xmlns.oracle.com/BPELProjects/OrderProcessing/OrderProcessing" location="../WSDLs/OrderProcessing.wsdl" importType="http://schemas.xmlsoap.org/wsdl/"/>
    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        PARTNERLINKS                                                      
        List of services participating in this BPEL process               
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    --> 
    <partnerLinks>
        <!-- 
      The 'client' role represents the requester of this service. It is 
      used for callback. The location and correlation information associated
      with the client role are automatically set using WS-Addressing.
    -->
        <partnerLink name="orderprocessing_client" partnerLinkType="client:OrderProcessing" myRole="OrderProcessingProvider" partnerRole="OrderProcessingRequester"/>
        <partnerLink name="ApprovalRules.ApprovalRulesService" partnerLinkType="ns1:ApprovalRules.ApprovalRulesService"
                     partnerRole="IDecisionService"/>
        <partnerLink name="ApprovalService" partnerLinkType="ns5:Approval" partnerRole="ApprovalProvider"
                     myRole="ApprovalRequester"/>
        <partnerLink name="ShippingRules.ShippingRulesService" partnerRole="IDecisionService_Role"
                     partnerLinkType="ns7:IDecisionService_PLT"/>
    </partnerLinks>

    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        VARIABLES                                                        
        List of messages and XML documents used within this BPEL process 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->
    <variables>
        <!-- Reference to the message passed as input during initiation -->
        <variable name="inputVariable" messageType="client:OrderProcessingRequestMessage"/>

        <!-- Reference to the message that will be sent back to the requester during callback -->
        <variable name="outputVariable" messageType="client:OrderProcessingResponseMessage"/>
        <variable name="needsApproval" type="xsd:boolean"/>
        <variable name="Invoke_Approval_callFunctionStateless_InputVariable"
                  messageType="ns1:callFunctionStatelessMessage"/>
        <variable name="Invoke_Approval_callFunctionStateless_OutputVariable"
                  messageType="ns1:callFunctionStatelessDecisionMessage"/>
        <variable name="Invoke_Approval_process_InputVariable" messageType="ns5:ApprovalRequestMessage"/>
        <variable name="Receive_Outcome_processResponse_InputVariable" messageType="ns5:ApprovalResponseMessage"/>
    </variables>

    <!-- 
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
       ORCHESTRATION LOGIC                                               
       Set of activities coordinating the flow of messages across the    
       services integrated within this business process                  
      ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    -->
    <sequence name="main">
        <!-- Receive input from requestor. (Note: This maps to operation defined in OrderProcessing.wsdl) -->
        <receive name="receiveInput" partnerLink="orderprocessing_client" portType="client:OrderProcessing" operation="process" variable="inputVariable" createInstance="yes"/>
        <scope name="ApprovalRule">
            <bpelx:annotation>
                <bpelx:pattern patternName="bpelx:decide"></bpelx:pattern>
            </bpelx:annotation>
            <variables>
                <variable name="dsIn" messageType="ns1:callFunctionStatelessMessage"/>
                <variable name="dsOut" messageType="ns1:callFunctionStatelessDecisionMessage"/>
            </variables>
            <sequence name="Sequence1">
                <assign name="Facts_To_Rule_Service">
                    <copy>
                        <from variable="inputVariable" part="payload"><query>ns2:orderTotal</query></from>
                        <to variable="dsIn" part="payload"><query>ns1:parameterList/ns4:price/ns4:totalPrice</query></to>
                    </copy>
                </assign>
                <assign name="BPEL_Header">
                    <copy>
                        <from>"ApprovalRulesService"</from>
                        <to variable="dsIn" part="payload"><query>@name</query></to>
                    </copy>
                </assign>
                <invoke name="Invoke" partnerLink="ApprovalRules.ApprovalRulesService" portType="ns1:IDecisionService"
                        operation="callFunctionStateless" inputVariable="dsIn" outputVariable="dsOut"/>
                <assign name="Rule_Service_To_Facts">
                    <copy>
                        <from variable="dsOut" part="payload"><query>ns1:resultList/ns4:approvalandiscount/ns4:approvalRequired</query></from>
                        <to variable="needsApproval"/>
                    </copy>
                </assign>
            </sequence>
        </scope>
        <if name="If1">
            <documentation>
                <![CDATA[needs approval]]>
            </documentation>
            <condition>$needsApproval=true()</condition>
            <sequence name="Sequence2">
                <assign name="Assign_Approval">
                    <copy>
                        <from>$inputVariable.payload/ns2:customerId</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:customerId</to>
                    </copy>
                    <copy>
                        <from>$inputVariable.payload/ns2:orderId</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:orderId</to>
                    </copy>
                    <copy>
                        <from>$inputVariable.payload/ns2:payMethod</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:payMethod</to>
                    </copy>
                    <copy>
                        <from>$inputVariable.payload/ns2:shipMethod</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:shipMethod</to>
                    </copy>
                    <copy>
                        <from>$inputVariable.payload/ns2:orderTotal</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:orderTotal</to>
                    </copy>
                    <copy>
                        <from>$inputVariable.payload/ns2:status</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:status</to>
                    </copy>
                    <copy>
                        <from>$inputVariable.payload/ns2:creditCard</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:creditCard</to>
                    </copy>
                    <copy>
                        <from>$inputVariable.payload/ns2:items</from>
                        <to>$Invoke_Approval_process_InputVariable.payload/ns6:items</to>
                    </copy>
                </assign>
                <invoke name="Invoke_Approval" bpelx:invokeAsDetail="no" partnerLink="ApprovalService"
                        portType="ns5:Approval" operation="process"
                        inputVariable="Invoke_Approval_process_InputVariable"/>
                <receive name="Receive_Outcome" partnerLink="ApprovalService" portType="ns5:ApprovalCallback"
                         operation="processResponse" variable="Receive_Outcome_processResponse_InputVariable"/>
                <assign name="Assign_Outcome">
                    <copy>
                        <from>$Receive_Outcome_processResponse_InputVariable.payload/ns6:status</from>
                        <to>$inputVariable.payload/ns2:status</to>
                    </copy>
                </assign>
            </sequence>
            <else>
                <documentation>
                    <![CDATA[auto approved]]>
                </documentation>
                <assign name="Assign_AutoApproved">
                    <copy>
                        <from>'APPROVED'</from>
                        <to>$inputVariable.payload/ns2:status</to>
                    </copy>
                </assign>
            </else>
        </if>
        <if name="If2">
            <documentation>
                <![CDATA[APPROVED]]>
            </documentation>
            <condition>$inputVariable.payload/ns2:status='APPROVED'</condition>
            <scope name="ShippingRules">
                <bpelx:annotation>
                    <bpelx:pattern patternName="bpelx:decide"></bpelx:pattern>
                </bpelx:annotation>
                <variables>
                    <variable name="dsIn" messageType="ns7:callFunctionStatelessMessage"/>
                    <variable name="dsOut" messageType="ns7:callFunctionStatelessDecisionMessage"/>
                </variables>
                <sequence name="Sequence3">
                    <assign name="Facts_To_Rule_Service">
                        <copy>
                            <from>string($inputVariable.payload/ns2:shipMethod)</from>
                            <to variable="dsIn" part="payload"><query>ns7:parameterList/ns8:shippinginfo/ns8:shipChoice</query></to>
                        </copy>
                    </assign>
                    <assign name="BPEL_Header">
                        <copy>
                            <from>"ShippingRulesService"</from>
                            <to variable="dsIn" part="payload"><query>@name</query></to>
                        </copy>
                    </assign>
                    <invoke name="Invoke" partnerLink="ShippingRules.ShippingRulesService"
                            portType="ns7:IDecisionService" operation="callFunctionStateless" inputVariable="dsIn"
                            outputVariable="dsOut"/>
                    <assign name="Rule_Service_To_Facts">
                        <copy>
                            <from variable="dsOut" part="payload"><query>ns7:resultList/ns8:shippingcompany/ns8:carrier</query></from>
                            <to variable="inputVariable" part="payload"><query>ns2:carrier</query></to>
                        </copy>
                    </assign>
                </sequence>
            </scope>
            <else>
                <documentation>
                    <![CDATA[REJECTED]]>
                </documentation>
                <empty name="Do_Nothing"/>
            </else>
        </if>
        <assign name="Assign_Output">
            <copy>
                <from>$inputVariable.payload</from>
                <to>$outputVariable.payload</to>
            </copy>
        </assign>
        <!-- 
          Asynchronous callback to the requester. (Note: the callback location and correlation id is transparently handled using WS-addressing.)
        -->
        <invoke name="callbackClient" partnerLink="orderprocessing_client" portType="client:OrderProcessingCallback" operation="processResponse" inputVariable="outputVariable"/>
    </sequence>
</process>