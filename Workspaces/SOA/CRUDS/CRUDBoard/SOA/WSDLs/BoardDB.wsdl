<wsdl:definitions
     name="BoardDB"
     targetNamespace="http://xmlns.oracle.com/pcbpel/adapter/db/Pruebas/CRUDBoard/BoardDB"
     xmlns:tns="http://xmlns.oracle.com/pcbpel/adapter/db/Pruebas/CRUDBoard/BoardDB"
     xmlns:jca="http://xmlns.oracle.com/pcbpel/wsdl/jca/"
     xmlns:plt="http://schemas.xmlsoap.org/ws/2003/05/partner-link/"
     xmlns:top="http://xmlns.oracle.com/pcbpel/adapter/db/top/BoardDB"
     xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    >
  <plt:partnerLinkType name="BoardDB_plt" >
    <plt:role name="BoardDB_role" >
      <plt:portType name="tns:BoardDB_ptt" />
    </plt:role>
  </plt:partnerLinkType>
    <wsdl:types>
      <schema xmlns="http://www.w3.org/2001/XMLSchema" >
        <import namespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/BoardDB" schemaLocation="../Schemas/BoardDB_table.xsd" />
      </schema>
    </wsdl:types>
    <wsdl:message name="BoardDBSelect_inputParameters">
        <wsdl:part name="BoardDBSelect_inputParameters" element="top:BoardDBSelectInputParameters"/>
    </wsdl:message>
    <wsdl:message name="selectByPrimaryKey_inputParameters">
        <wsdl:part name="selectByPrimaryKey_inputParameters" element="top:BoardPrimaryKey"/>
    </wsdl:message>
    <wsdl:message name="BoardCollection_msg">
        <wsdl:part name="BoardCollection" element="top:BoardCollection"/>
    </wsdl:message>
    <wsdl:portType name="BoardDB_ptt">
        <wsdl:operation name="insert">
            <wsdl:input message="tns:BoardCollection_msg"/>
            <wsdl:output message="tns:BoardCollection_msg"/>
        </wsdl:operation>
        <wsdl:operation name="update">
            <wsdl:input message="tns:BoardCollection_msg"/>
            <wsdl:output message="tns:BoardCollection_msg"/>
        </wsdl:operation>
        <wsdl:operation name="BoardDBSelect">
            <wsdl:input message="tns:BoardDBSelect_inputParameters"/>
            <wsdl:output message="tns:BoardCollection_msg"/>
        </wsdl:operation>
        <wsdl:operation name="selectByPrimaryKey">
            <wsdl:input message="tns:selectByPrimaryKey_inputParameters"/>
            <wsdl:output message="tns:BoardCollection_msg"/>
        </wsdl:operation>
    </wsdl:portType>
</wsdl:definitions>
