<wsdl:definitions
     name="CardDB"
     targetNamespace="http://xmlns.oracle.com/pcbpel/adapter/db/CRUDS/CrudCard/CardDB"
     xmlns:tns="http://xmlns.oracle.com/pcbpel/adapter/db/CRUDS/CrudCard/CardDB"
     xmlns:jca="http://xmlns.oracle.com/pcbpel/wsdl/jca/"
     xmlns:plt="http://schemas.xmlsoap.org/ws/2003/05/partner-link/"
     xmlns:top="http://xmlns.oracle.com/pcbpel/adapter/db/top/CardDB"
     xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    >
  <plt:partnerLinkType name="CardDB_plt" >
    <plt:role name="CardDB_role" >
      <plt:portType name="tns:CardDB_ptt" />
    </plt:role>
  </plt:partnerLinkType>
    <wsdl:types>
      <schema xmlns="http://www.w3.org/2001/XMLSchema" >
        <import namespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/CardDB" schemaLocation="../Schemas/CardDB_table.xsd" />
      </schema>
    </wsdl:types>
    <wsdl:message name="CardDBSelect_inputParameters">
        <wsdl:part name="CardDBSelect_inputParameters" element="top:CardDBSelectInputParameters"/>
    </wsdl:message>
    <wsdl:message name="selectByPrimaryKey_inputParameters">
        <wsdl:part name="selectByPrimaryKey_inputParameters" element="top:CardPrimaryKey"/>
    </wsdl:message>
    <wsdl:message name="CardCollection_msg">
        <wsdl:part name="CardCollection" element="top:CardCollection"/>
    </wsdl:message>
    <wsdl:portType name="CardDB_ptt">
        <wsdl:operation name="insert">
            <wsdl:input message="tns:CardCollection_msg"/>
            <wsdl:output message="tns:CardCollection_msg"/>
        </wsdl:operation>
        <wsdl:operation name="update">
            <wsdl:input message="tns:CardCollection_msg"/>
            <wsdl:output message="tns:CardCollection_msg"/>
        </wsdl:operation>
        <wsdl:operation name="delete">
            <wsdl:input message="tns:CardCollection_msg"/>
            <wsdl:output message="tns:CardCollection_msg"/>
        </wsdl:operation>
        <wsdl:operation name="CardDBSelect">
            <wsdl:input message="tns:CardDBSelect_inputParameters"/>
            <wsdl:output message="tns:CardCollection_msg"/>
        </wsdl:operation>
        <wsdl:operation name="selectByPrimaryKey">
            <wsdl:input message="tns:selectByPrimaryKey_inputParameters"/>
            <wsdl:output message="tns:CardCollection_msg"/>
        </wsdl:operation>
    </wsdl:portType>
</wsdl:definitions>
