<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="GetAllUser">RestService</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbReference" schemaLocation="../Schemas/getalluser_payload.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/User/GetAllV2">
         <method name="GET" soa:wsdlOperation="Operation1">
            <request/>
            <response status="200">
               <representation mediaType="application/json" element="cns:UserCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbReference"/>
            </response>
         </method>
      </resource>
   </resources>
</application>
