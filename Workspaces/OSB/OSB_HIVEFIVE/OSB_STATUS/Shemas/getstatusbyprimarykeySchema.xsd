<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema targetNamespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus" xmlns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbStatus"
     elementFormDefault="qualified" attributeFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="StatusCollection" type="StatusCollection"/>
    <xs:complexType name="StatusCollection">
        <xs:sequence>
            <xs:element name="Status" type="Status" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="Status">
        <xs:sequence>
            <xs:element name="id" type="xs:int" nillable="true"/>
            <xs:element name="name" type="xs:string" minOccurs="0" nillable="true"/>
        </xs:sequence>
    </xs:complexType>
    <xs:element name="dbStatusSelectInputParameters" type="dbStatusSelect"/>
    <xs:complexType name="dbStatusSelect">
        <xs:sequence/>
    </xs:complexType>
    <xs:element name="StatusPrimaryKey" type="StatusPrimaryKey"/>
    <xs:complexType name="StatusPrimaryKey">
        <xs:sequence>
            <xs:element name="id" type="xs:int" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>