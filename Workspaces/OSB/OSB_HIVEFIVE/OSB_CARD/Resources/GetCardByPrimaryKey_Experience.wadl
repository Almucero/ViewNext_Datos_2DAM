<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="GetCardByPrimaryKey_Experience">RestService</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard" schemaLocation="../Schemas/GetCardByPrimaryKey_Payload.xsd"/>
        </xsd:schema>
      <schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://xmlns.oracle.com/OSB_HIVEFIVE/OSB_CARD/GetCardByPrimaryKey_Experience" elementFormDefault="qualified">
            <element name="getCardByPrimaryKey_params">
                <complexType>
                    <sequence>
                        <element name="id_card" type="string"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
   </grammars>
   <resources>
      <resource path="/cards/get/{id_card}">
         <method name="GET" soa:wsdlOperation="getCardByPrimaryKey">
            <request soa:paramElement="pns:getCardByPrimaryKey_params" xmlns:pns="http://xmlns.oracle.com/OSB_HIVEFIVE/OSB_CARD/GetCardByPrimaryKey_Experience">
               <param name="id_card" style="template" soa:expression="$msg.request/pns:id_card" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:CardCollection" xmlns:cns="http://xmlns.oracle.com/pcbpel/adapter/db/top/dbCard"/>
            </response>
         </method>
      </resource>
   </resources>
</application>
