  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:8000/",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/src/ts/jet-composites/demo-update-item/1.0.0/*": "${webRoot}/src/ts/jet-composites/demo-update-item/*"
      }
    }
  ]
}
